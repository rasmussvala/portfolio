---
// Document shell: meta, design tokens and global styles.
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="color-scheme" content="light dark" />
	</head>
	<body id="top">
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #fbfbfd;
		--surface: #ffffff;
		--text: #1d1d1f;
		--text-2: #6e6e73;
		--text-3: #86868b;
		--hairline: rgba(0, 0, 0, 0.08);
		--accent: #0071e3;
		--material: rgba(251, 251, 253, 0.72);
		--edge: rgba(0, 0, 0, 0.04);
		--shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 8px 24px rgba(0, 0, 0, 0.06);

		--content: 980px;
		--gutter: 1.25rem;
		--radius-lg: 22px;

		--ease-out: cubic-bezier(0.23, 1, 0.32, 1);

		color-scheme: light dark;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #000000;
			--surface: #161617;
			--text: #f5f5f7;
			--text-2: #a1a1a6;
			--text-3: #86868b;
			--hairline: rgba(255, 255, 255, 0.1);
			--accent: #2997ff;
			--material: rgba(22, 22, 23, 0.72);
			--edge: rgba(0, 0, 0, 0.3);
			--shadow: 0 0 0 1px rgba(255, 255, 255, 0.06);
		}
	}

	@media (prefers-contrast: more) {
		:root {
			--text-2: var(--text);
			--text-3: var(--text);
			--hairline: currentColor;
		}
	}

	/* Translucent materials become solid */
	@media (prefers-reduced-transparency: reduce) {
		:root {
			--material: var(--bg);
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
		scroll-padding-top: 3.5rem;
	}

	body {
		margin: 0;
		padding-bottom: 6rem;
		background: var(--bg);
		color: var(--text);
		font: 100%/1.5 -apple-system, BlinkMacSystemFont, system-ui, 'Segoe UI', Roboto, sans-serif;
		font-optical-sizing: auto;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	img {
		display: block;
		max-width: 100%;
	}

	h1,
	h2,
	h3,
	p {
		margin: 0;
	}

	/* Shared entrance: fade and a small rise, ease-out. Backwards fill so it never holds a transform afterwards. */
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}

	.rise {
		animation: rise 500ms var(--ease-out) backwards;
		animation-delay: calc(var(--i, 0) * 60ms);
	}

	@media (prefers-reduced-motion: reduce) {
		@keyframes rise {
			from {
				opacity: 0;
			}
		}
		.rise {
			animation-duration: 200ms;
			animation-delay: 0ms;
		}
	}
</style>
