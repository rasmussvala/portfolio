---
// Every project in one grid, filtered by a sticky segmented control. Works without JavaScript:
// the segments are native radios, and the grid and thumb follow whichever one is :checked.
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

// Featured work first, then newest first
const projects = (await getCollection('projects'))
	.map((entry) => entry.data)
	.sort((a, b) => Number(b.featured) - Number(a.featured) || b.year - a.year || a.title.localeCompare(b.title));

const segments = [
	{ id: 'all', label: 'All', count: projects.length },
	{ id: 'personal', label: 'Personal', count: projects.filter((p) => p.group === 'personal').length },
	{ id: 'university', label: 'University', count: projects.filter((p) => p.group === 'university').length },
];
---

<section class="work" id="work" aria-label="Work">
	<div class="bar rise" style="--i: 2">
		<div class="segmented" role="radiogroup" aria-label="Filter projects">
			<span class="thumb" aria-hidden="true"></span>
			{
				segments.map((s, i) => (
					<label>
						<input type="radio" name="group" value={s.id} checked={i === 0} />
						{s.label}
						<span class="count">{s.count}</span>
					</label>
				))
			}
		</div>
	</div>

	<div class="grid">
		{projects.map((p, i) => <ProjectCard project={p} eager={i < 2} class="rise" style={`--i: ${Math.min(4 + i, 10)}`} />)}
	</div>
</section>

<style>
	/* Sticky under the nav so the control stays reachable while scrolling */
	.bar {
		position: sticky;
		top: 3.5rem;
		z-index: 5;
		display: flex;
		justify-content: center;
		padding: 0.5rem 0;
	}

	.segmented {
		position: relative;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		padding: 3px;
		border-radius: 999px;
		background: var(--material);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		backdrop-filter: blur(20px) saturate(180%);
		box-shadow: 0 0 0 1px var(--hairline);
	}

	.thumb {
		position: absolute;
		top: 3px;
		bottom: 3px;
		left: 3px;
		width: calc((100% - 6px) / 3);
		border-radius: 999px;
		background: var(--surface);
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.08),
			0 3px 8px rgba(0, 0, 0, 0.08);
		transition: transform 300ms var(--ease-out);
	}

	label {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		min-width: 6.5rem;
		padding: 0.5rem 1rem;
		color: var(--text-2);
		font-size: 0.875rem;
		font-weight: 500;
		cursor: pointer;
		user-select: none;
		-webkit-user-select: none;
		transition: color 150ms ease-out;
	}

	input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.count {
		color: var(--text-3);
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
	}

	label:has(:checked) {
		color: var(--text);
	}

	.segmented:has(input:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.work:has([value='personal']:checked) .thumb {
		transform: translateX(100%);
	}
	.work:has([value='university']:checked) .thumb {
		transform: translateX(200%);
	}

	.grid {
		margin-top: 1.5rem;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.work:has([value='personal']:checked) .grid > :global([data-group='university']),
	.work:has([value='university']:checked) .grid > :global([data-group='personal']) {
		display: none;
	}

	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
		label {
			min-width: 0;
			padding: 0.5rem 0.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.thumb {
			transition: none;
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		.segmented {
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
	}
</style>
